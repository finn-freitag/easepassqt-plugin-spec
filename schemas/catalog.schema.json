{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/finn-freitag/easepassqt-plugin-spec/blob/main/schemas/catalog.schema.json",
  "title": "Ease Pass plugin catalog (PluginList.json)",
  "description": "List of published plugins. The sha256 of a package decides whether an install is 'verified'. Unknown properties are ignored.",
  "type": "object",
  "required": ["schema", "updated", "plugins"],
  "properties": {
    "schema": {
      "description": "Version of this file format.",
      "const": 1
    },
    "updated": {
      "description": "UTC time of the last change, e.g. 2026-10-14T00:00:00Z.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "plugins": {
      "type": "array",
      "items": { "$ref": "#/$defs/plugin" }
    }
  },
  "$defs": {
    "plugin": {
      "type": "object",
      "required": ["id", "name", "description", "author", "version", "api_version", "download_url", "sha256"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*(\\.[a-z][a-z0-9]*(-[a-z0-9]+)*)+$",
          "maxLength": 128
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "maxLength": 2000 },
        "author": { "type": "string", "maxLength": 120 },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$",
          "maxLength": 64
        },
        "api_version": { "type": "integer", "minimum": 1 },
        "os": {
          "description": "Missing or empty = all operating systems.",
          "type": "array",
          "items": { "enum": ["windows", "linux", "macos"] },
          "uniqueItems": true
        },
        "download_url": {
          "description": "HTTPS URL of the .epplugin package.",
          "type": "string",
          "pattern": "^https://",
          "maxLength": 2048
        },
        "icon_url": {
          "type": "string",
          "pattern": "^https://",
          "maxLength": 2048
        },
        "sha256": {
          "description": "Lower-case hex SHA-256 of the exact .epplugin bytes.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sensitive": {
          "description": "Display hint for the store list only. The install dialog uses the values the host computes.",
          "type": "boolean"
        },
        "min_app_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "revoked": {
          "description": "true = the host refuses to install or load this package.",
          "type": "boolean"
        }
      }
    }
  }
}
